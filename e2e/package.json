{
	"name": "e2e",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"fixtures": "vite",
		"build:motion": "bun run --filter motion-sv build",
		"test": "bun run build:motion && playwright test",
		"test:playground": "bun run build:motion && playwright test --project=playground",
		"test:upstream": "bun run build:motion && playwright test --project=upstream",
		"report": "playwright show-report"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^24.13.3",
		"svelte": "^5.57.1",
		"typescript": "~6.0.3",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"motion-sv": "workspace:*"
	}
}
