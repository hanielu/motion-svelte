{
	"name": "root",
	"version": "0.0.0",
	"private": true,
	"license": "MIT",
	"author": "Haniel Ubogu <https://github.com/HanielU>",
	"scripts": {
		"build": "bun run --workspaces --if-present build",
		"build:packages": "bun run --filter motion-sv --filter motion-rsv --filter runed build",
		"check": "bun run build:packages && bun run --workspaces --if-present check",
		"dev": "bun run --workspaces --parallel --if-present dev",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:e2e": "bun run --filter e2e test",
		"release": "bun run build:packages && changeset publish"
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.3",
		"eslint": "^9.7.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.36.0",
		"globals": "^15.0.0",
		"prettier": "^3.3.2",
		"prettier-plugin-svelte": "^3.2.6",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.0.0"
	},
	"workspaces": [
		"packages/*",
		"playground/*",
		"e2e",
		"docs"
	]
}
