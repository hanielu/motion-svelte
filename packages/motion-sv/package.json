{
	"name": "motion-sv",
	"version": "0.2.0",
	"description": "Motion (formerly Framer Motion) for Svelte 5: motion components, gestures, layout and shared layout animations, exit animations, scroll and motion values, on the same engine as Motion for React and Vue",
	"license": "MIT",
	"author": "Haniel Ubogu <https://github.com/HanielU>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hanielu/motion-svelte.git"
	},
	"homepage": "https://github.com/hanielu/motion-svelte#readme",
	"bugs": "https://github.com/hanielu/motion-svelte/issues",
	"keywords": [
		"svelte",
		"svelte5",
		"svelte-5",
		"sveltekit",
		"runes",
		"motion",
		"framer-motion",
		"framer-motion-svelte",
		"svelte-motion",
		"motion-svelte",
		"animation",
		"svelte-animation",
		"layout-animation",
		"shared-layout",
		"animate-presence",
		"exit-animation",
		"gestures",
		"drag",
		"spring",
		"scroll-animation",
		"motion-values",
		"variants"
	],
	"scripts": {
		"dev": "svelte-kit sync && svelte-package --watch",
		"build": "svelte-kit sync && svelte-package && publint",
		"prepack": "bun run build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "vitest --run"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"peerDependencies": {
		"svelte": "^5.40.0"
	},
	"dependencies": {
		"csstype": "^3.2.3",
		"framer-motion": "14.1.0",
		"hey-listen": "^1.0.8",
		"motion-dom": "14.1.0",
		"motion-utils": "14.1.0"
	},
	"devDependencies": {
		"@hvniel/vite-plugin-svelte-inline-component": "^0.0.17",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@vitest/browser-playwright": "^4.1.8",
		"playwright": "^1.60.0",
		"publint": "^0.3.21",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	}
}
